{
  "name": "@enntity/accord",
  "version": "0.5.0",
  "type": "module",
  "description": "Discover agents, exchange messages, and share resources with safe recovery",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enntity/accord.git"
  },
  "homepage": "https://github.com/Enntity/accord#readme",
  "bugs": {
    "url": "https://github.com/Enntity/accord/issues"
  },
  "keywords": [
    "agents",
    "coordination",
    "mcp",
    "claude-code",
    "codex",
    "reservations",
    "sqlite"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "accord": "src/cli.mjs"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "demo": "node demo/recovery.mjs",
    "verify": "node scripts/verify.mjs",
    "start": "node src/cli.mjs up",
    "demo:process": "node demo/process-recovery.mjs",
    "demo:bootstrap": "node demo/bootstrap.mjs"
  },
  "files": [
    "src/",
    "skills/",
    "vendor/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "docs/",
    "!docs/assets",
    "native/"
  ]
}
