              "SPARKLING_DRAFTER=${sparklingDrafter}",
              "-e",
              "SPARKLING_QUANT=${sparklingQuant}",
              "-e",
              "SPARKLING_MODE=${sparklingMode}",
              "-e",
              "SPARKLING_PREFILL_PRECISION=${prefillPrecision}",
              "-e",
              "SPARKLING_DECODE_PRECISION=${decodePrecision}",
              "-e",
              "SPARKLING_PROFILE=${sparklingProfile}",
              "-e",
              "SPARKLING_TOOL_GUARD=stream",
              "-e",
              "SPARKLING_TOOL_GUARD_MAX_BYTES=1048576",
              "-e",
              "SPARKLING_TOOL_GUARD_ALLOW_HOSTS=",
              "-e",
              "SPARKLING_TOOL_GUARD_DENY_HOSTS=",
              "-e",
              "CUDA_CACHE_PATH=/atlas-cuda-cache",
              "-e",
              "CUDA_CACHE_MAXSIZE=4294967296"
            ]
          }
        }
      }
    }
  ]
}
