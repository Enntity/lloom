  "name": "DGX Spark GLM-5.3 Flash FP4-Local Atlas (SparkGLM 0.3.4 candidate)",
  "version": 5,
  "options": {
    "sparks": {
      "description": "How many DGX Sparks serve the model: 2 is a TP-2 pair over a direct cable, 4 is TP-4 over a daisy chain.",
      "default": "2",
