                    "-e", "QWEN_MODEL=RadixArk/Qwen3.8-Flash-Next-NVFP4",
                    "-e", "QWEN_MODEL_REVISION=7b719225242aacd3dbd3f9407468c2ee9a9d2594",
                    "-e", "SERVED_MODEL_NAME=qwen3.8-flash-next", "-e", "MAX_MODEL_LEN=262144", "-e", "MAX_NUM_SEQS=8",
                    "-e", "MAX_NUM_BATCHED_TOKENS=8192", "-e", "GPU_MEMORY_UTILIZATION=0.80"
                  ],
                  "command": ["/opt/lloom/qwen38-entrypoint.sh"]
                }
              }
            },
            {
