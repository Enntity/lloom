                  "image": "vllm/vllm-openai@sha256:3b0e188ffceb3d07e09c3cb5215433a0020eacf02d7f882ed3a8bfd15454477e",
                  "pullTimeoutMs": 3600000,
                  "createArgs": [
                    "--restart", "unless-stopped", "--network", "host", "--ipc", "host", "--shm-size", "32g",
                    "--cap-add", "SYS_NICE", "--ulimit", "memlock=-1", "--ulimit", "stack=67108864", "--gpus", "all",
