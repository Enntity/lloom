                    "-v", "${home}/.cache/vllm:/root/.cache/vllm",
                    "--mount", "type=bind,src=${lloomRoot}/backends/qwen38-vllm/entrypoint.sh,dst=/opt/lloom/qwen38-entrypoint.sh,readonly",
                    "--mount", "type=bind,src=${lloomRoot}/backends/qwen38-vllm/apply-ple-fp8-patch.py,dst=/opt/lloom/apply-ple-fp8-patch.py,readonly",
                    "-e", "NODE_ADDRESS=${nodeAddress}", "-e", "FABRIC_INTERFACE=${fabricInterface}", "-e", "NODE_RANK=${nodeRank}",
                    "-e", "CLUSTER_NODE_COUNT=${clusterNodeCount}", "-e", "MASTER_ADDR=${leaderAddress}", "-e", "MASTER_PORT=50000",
                    "-e", "VLLM_HOST_IP=${nodeAddress}", "-e", "VLLM_PORT=8889",
                    "-e", "GLOO_SOCKET_IFNAME=${fabricInterface}", "-e", "NCCL_SOCKET_IFNAME=${fabricInterface}", "-e", "TP_SOCKET_IFNAME=${fabricInterface}",
                    "-e", "NCCL_NET=IB", "-e", "NCCL_IB_DISABLE=0", "-e", "NCCL_IB_GID_INDEX=3", "-e", "NCCL_IB_AUTO_DETECT=0",
                    "-e", "NCCL_CROSS_NIC=1", "-e", "NCCL_CUMEM_ENABLE=0", "-e", "NCCL_NVLS_ENABLE=0", "-e", "NCCL_DEBUG=WARN",
                    "-e", "TORCH_NCCL_ASYNC_ERROR_HANDLING=1", "-e", "PLE_FORCE_FP8=1",
