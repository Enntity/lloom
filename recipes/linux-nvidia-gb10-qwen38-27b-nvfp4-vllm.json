{
  "$schema": "https://lloom.dev/schemas/recipe.v1.schema.json",
  "schemaVersion": 1,
  "profile": "https://lloom.dev/profiles/interchange/v1",
  "id": "linux-nvidia-gb10-qwen38-27b-nvfp4-vllm",
  "name": "DGX Spark Qwen3.8 27B NVFP4 vLLM",
  "version": 1,
  "summary": "Standalone Qwen3.8 27B NVFP4 cognition model for a single 128 GB NVIDIA GB10, sized to coexist with the Qwen3-Embedding-4B sidecar. MTP speculative decoding, FP8 KV, prefix caching, 262k native context.",
  "license": { "id": "Apache-2.0", "name": "Apache License 2.0" },
  "provenance": {
    "createdBy": "lloom",
    "generatedBy": "manual-curated",
    "source": "unsloth/Qwen3.8-27B-NVFP4 model card; NVIDIA developer forum thread 380244 (Helge, 2026-08-15); MiaAI-Lab/Qwen3.8-27B-DGX-Spark-RTX-6000 start.sh"
  },
  "links": [
    { "rel": "base-model", "href": "https://huggingface.co/Qwen/Qwen3.8-27B", "mediaType": "text/html" },
    { "rel": "model", "href": "https://huggingface.co/unsloth/Qwen3.8-27B-NVFP4", "mediaType": "text/html" },
    {
      "rel": "reference",
      "href": "https://forums.developer.nvidia.com/t/qwen3-8-27b-nvfp4-on-a-single-dgx-spark-up-to-1m-context-vllm-mtp-measurements/380244",
      "mediaType": "text/html"
    },
    {
      "rel": "reference",
      "href": "https://github.com/MiaAI-Lab/Qwen3.8-27B-DGX-Spark-RTX-6000",
      "mediaType": "text/html"
    }
  ],
  "keywords": ["linux", "nvidia", "dgx-spark", "gb10", "qwen3.8", "27b", "nvfp4", "vllm", "mtp", "standalone"],
  "capabilities": [
    "chat",
    "responses",
    "anthropic-messages",
    "streaming",
    "usage",
    "tools",
    "reasoning",
    "vision",
    "mtp",
    "batching",
    "long-context"
  ],
  "hardware": {
    "family": "NVIDIA GB10 / DGX Spark",
    "testedMachine": "DGX Spark with 128 GB unified memory",
    "notes": [
      "Standalone cognition slot on one Spark while other nodes run cluster experiments; Qwen3-Embedding-4B sidecar (~8 GiB weights + runtime) stays resident.",
      "gpu-memory-utilization 0.55 leaves headroom for the embedding runtime and OS; raise toward 0.84 (MiaAI-Lab default) only with the embedding sidecar stopped.",
      "Decoder-only start: keep 262144 native context. YaRN 1M is intentionally not enabled by default (static YaRN perturbs short-context quality)."
    ]
  },
  "requirements": {
    "platforms": ["linux-arm64"],
    "memoryGb": 80,
    "diskGb": 40,
    "commands": ["docker"],
    "accelerators": ["cuda", "nvidia-gpu", "blackwell", "gb10"]
  },
  "backend": {
    "id": "docker-vllm",
    "name": "Docker vLLM for NVIDIA GB10",
    "type": "openai-compatible-server",
    "features": ["cuda", "blackwell", "openai-chat", "streaming", "tools", "vision", "batching", "mtp"]
  },
  "setup": {
    "steps": [
      {
        "id": "check-docker",
        "title": "Check Docker",
        "action": "check-command",
        "command": "docker",
        "args": ["--version"]
      }
    ]
  },
  "models": [
    {
      "role": "standalone-cognition",
      "model": "unsloth/Qwen3.8-27B-NVFP4",
      "gatewayModel": "qwen38-27b-nvfp4",
      "runtime": "qwen38-27b-nvfp4",
      "backendConfig": "qwen38-27b-nvfp4",
      "backend": "vLLM CUDA",
      "input": ["text", "image"],
      "output": ["text"],
      "capabilities": [
        "chat",
        "responses",
        "anthropic-messages",
        "streaming",
        "usage",
        "tools",
        "reasoning",
        "vision",
        "mtp",
        "batching",
        "long-context"
      ],
      "settings": {
        "contextWindow": 262144,
        "maxOutputTokens": 32768,
        "maxActiveRequests": 4,
        "memoryGb": 40,
        "priority": 70,
        "keepWarm": false,
        "startupTimeoutMs": 900000,
        "runtime": {
          "adapter": "docker",
          "management": "managed",
          "containerName": "lloom-qwen38-27b-nvfp4",
          "healthUrl": "http://127.0.0.1:${port}/health",
          "bootstrap": {
            "adapter": "docker",
            "image": "vllm/vllm-openai@sha256:13ea3b228a97a12482302341942fd1e5694395ad2c46f940de15fa8f4b4a7a1d",
            "createArgs": [
              "--restart",
              "unless-stopped",
              "--gpus",
              "all",
              "--ipc",
              "host",
              "-p",
              "127.0.0.1:${port}:8000",
              "-e",
              "CUTE_DSL_ARCH=sm_121a",
              "-v",
              "lloom-huggingface-cache:/root/.cache/huggingface",
              "-v",
              "lloom-vllm-cache:/root/.cache/vllm"
            ],
            "command": [
              "${upstreamModel}",
              "--host",
              "0.0.0.0",
              "--port",
              "8000",
              "--served-model-name",
              "${upstreamModel}",
              "--quantization",
              "compressed-tensors",
              "--tensor-parallel-size",
              "1",
              "--trust-remote-code",
              "--kv-cache-dtype",
              "fp8",
              "--attention-backend",
              "triton_attn",
              "--gpu-memory-utilization",
              "0.55",
              "--max-model-len",
              "262144",
              "--max-num-seqs",
              "4",
              "--max-num-batched-tokens",
              "8192",
              "--enable-chunked-prefill",
              "--enable-prefix-caching",
              "--distributed-executor-backend",
              "mp",
              "--reasoning-parser",
              "qwen3",
              "--tool-call-parser",
              "qwen3_xml",
              "--enable-auto-tool-choice",
              "--speculative-config",
              "{\"method\":\"mtp\",\"num_speculative_tokens\":5}"
            ]
          }
        }
      }
    }
  ]
}
