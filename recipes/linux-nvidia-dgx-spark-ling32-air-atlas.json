              "SPARKLING_TOOL_GUARD=stream",
              "-e",
              "SPARKLING_TOOL_GUARD_MAX_BYTES=1048576",
              "-e",
              "SPARKLING_TOOL_GUARD_ALLOW_HOSTS=",
              "-e",
              "SPARKLING_TOOL_GUARD_DENY_HOSTS=",
              "-e",
              "CUDA_CACHE_PATH=/atlas-cuda-cache",
              "-e",
              "CUDA_CACHE_MAXSIZE=4294967296"
            ]
          }
        }
      }
    }
  ]
}
