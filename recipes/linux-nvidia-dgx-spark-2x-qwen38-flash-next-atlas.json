        "title": "Check Docker",
        "action": "check-command",
        "command": "docker",
        "args": ["version"]
      },
      {
        "id": "verify-atlas-pins",
        "title": "Verify the Atlas SparkQwen pin manifest is final",
        "action": "command",
        "alwaysRun": true,
        "command": "node",
        "args": ["${repoRoot}/backends/atlas-sparkqwen/verify-pins.mjs"]
      },
      {
        "id": "download-atlas-model",
        "title": "Acquire the pinned Qwen3.8 Flash Next NVFP4 checkpoint",
        "action": "download-model",
        "provider": "huggingface",
        "model": "nvidia/Qwen3.8-Flash-Next-NVFP4",
        "revision": "fc694b54fb0174e0913e6adf86691ef85a4ead47"
      },
      {
        "id": "pull-atlas-image",
        "title": "Pull or verify the pinned Atlas SparkQwen image on this node",
        "action": "command",
        "alwaysRun": true,
        "command": "bash",
        "args": ["${repoRoot}/backends/atlas-sparkqwen/install.sh"]
      },
      {
        "id": "prepare-atlas-cuda-cache",
        "title": "Create the persistent CUDA JIT cache directory",
        "action": "command",
        "alwaysRun": true,
        "command": "mkdir",
        "args": ["-p", "${installRoot}/atlas-sparkqwen-cuda-cache"]
      }
    ]
