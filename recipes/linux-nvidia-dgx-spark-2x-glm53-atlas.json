  "hardware": {
    "family": "NVIDIA DGX Spark / GB10",
    "testedMachine": "Two directly connected DGX Spark systems",
    "notes": [
      "Candidate lane: no live hardware qualification has been recorded through LLooM yet. The profile and capability claims below come from the source build and focused checks; gateway and two-node serving canaries remain required before treating this recipe as qualified.",
      "TP2 with expert parallelism 2 across the private ConnectX RoCE fabric. The direct-fabric address and NIC are discovered per node and passed as MASTER_ADDR and FABRIC_INTERFACE; no host-specific addresses are pinned.",
      "The worker is admitted first (rank 1) and readiness-checked through its container state, because the Atlas engine has no separate worker HTTP surface. The leader starts second (rank 0) and owns routing.",
      "The NVFP4 checkpoint requires a per-node overlay conversion before it can be served. LLooM treats the conversion as incomplete unless conversion.complete.json plus its recorded verification are present.",
      "Both nodes must carry the same portable source, model and converter pins plus the same backend directory. Each host verifies its own node-local image against its build receipt and OCI revision label; image IDs may differ across hosts.",
      "Peak container memory is capped at 114 GiB with a 4096 MiB OOM guard, matching the measured baseline. The profile uses a 36864-token total context with native MTP through 32768 and fallback above that boundary; the parent owner will update qualification wording after the live gates pass."
    ]
  },
  "requirements": {
    "platforms": ["linux-arm64"],
    "memoryGb": 114,
    "diskGb": 220,
    "commands": ["docker", "git"],
    "accelerators": ["cuda", "nvidia-gpu", "blackwell", "gb10"],
    "cluster": {
      "nodes": 2,
      "provider": "nvidia-sync",
      "topology": "direct"
    }
  },
  "backend": {
    "id": "docker-atlas-sparkglm",
    "name": "Source-built Atlas SparkGLM image",
    "type": "openai-compatible-server"
  },
  "setup": {
    "steps": [
      {
        "id": "check-docker",
        "title": "Check Docker",
        "action": "check-command",
        "command": "docker",
        "args": ["version"]
      },
      {
        "id": "verify-atlas-pins",
        "title": "Verify the Atlas SparkGLM pin manifest is final",
        "action": "command",
        "alwaysRun": true,
        "command": "node",
        "args": ["${repoRoot}/backends/atlas-sparkglm/verify-pins.mjs"]
      },
      {
        "id": "download-atlas-model",
        "title": "Acquire the pinned GLM-5.3 Flash NVFP4 checkpoint",
        "action": "download-model",
        "provider": "huggingface",
        "model": "nvidia/GLM-5.3-Flash-NVFP4",
        "revision": "423acf37583782c51c142d145aef733d72943d93"
      },
      {
        "id": "build-atlas-image",
        "title": "Build or verify the pinned Atlas SparkGLM image on this node",
        "action": "command",
        "alwaysRun": true,
        "command": "bash",
        "args": [
          "${repoRoot}/backends/atlas-sparkglm/install.sh",
          "--backend-root",
          "${backendRoot}",
          "--install-root",
          "${installRoot}"
        ]
      },
      {
        "id": "convert-atlas-overlay",
        "title": "Convert the GLM-5.3 Flash NVFP4 overlay for this node (once)",
        "action": "command",
        "alwaysRun": true,
        "command": "bash",
        "args": [
          "${repoRoot}/backends/atlas-sparkglm/convert-overlay.sh",
          "--backend-root",
          "${backendRoot}",
          "--install-root",
          "${installRoot}",
          "--model-root",
          "${modelRoot}"
        ]
      }
    ]
  },
