        "action": "command",
        "alwaysRun": true,
        "command": "node",
        "args": [
          "${repoRoot}/backends/atlas-sparkglm/verify-pins.mjs"
        ]
      },
      {
        "id": "download-atlas-model",
        "title": "Acquire the pinned GLM-5.3 Flash NVFP4 checkpoint",
        "action": "download-model",
        "provider": "huggingface",
        "model": "nvidia/GLM-5.3-Flash-NVFP4",
        "revision": "423acf37583782c51c142d145aef733d72943d93"
      },
      {
        "id": "download-atlas-drafter",
        "title": "Acquire the pinned GLM-5.3 Flash DFlash2 drafter",
        "action": "download-model",
        "provider": "huggingface",
        "model": "incoai/GLM-5.3-Flash-DFlash2",
        "revision": "7d74cdd881ed7e32c31175984a67823127b66cfe"
      },
      {
        "id": "build-atlas-image",
        "title": "Build or verify the pinned Atlas SparkGLM image on this node",
        "action": "command",
        "alwaysRun": true,
        "command": "bash",
        "args": [
          "${repoRoot}/backends/atlas-sparkglm/install.sh",
          "--backend-root",
          "${backendRoot}",
          "--install-root",
          "${installRoot}"
        ]
      },
      {
        "id": "convert-atlas-overlay",
        "title": "Convert the GLM-5.3 Flash NVFP4 overlay for this node (once)",
        "action": "command",
        "alwaysRun": true,
        "command": "bash",
        "args": [
          "${repoRoot}/backends/atlas-sparkglm/convert-overlay.sh",
          "--backend-root",
          "${backendRoot}",
          "--install-root",
          "${installRoot}",
          "--model-root",
          "${modelRoot}"
        ]
      }
    ]
