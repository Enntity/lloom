  "id": "linux-nvidia-gb10-drama3-tensorfold",
  "name": "Drama 3 expressive TTS (DGX Spark, TensorFold)",
  "version": 1,
  "summary": "Fish Audio Drama 3, pruned NVFP4, on the TensorFold CUDA engine for one DGX Spark: expressive 44.1 kHz narration in a cloned voice, with PCM streaming, through LLooM's OpenAI speech API.",
  "license": {
